<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/<%= user.username %>" class="text-success text-decoration-none">
                            <img src="<%= user.avatar %>" class="rounded-circle me-1" style="width: 24px; height: 24px; object-fit: cover;" alt="<%= user.username %> Avatar">
                        </a>
                        <a href="/<%= user.username %>"
                            class="text-success text-decoration-none">
                            <%= user.username %>
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Create Project</li>
                </ol>
            </nav>

            <div class="card bg-dark border-secondary">
                <div class="card-header bg-dark border-secondary">
                    <h4 class="mb-0"><i class="bi bi-plus-circle-fill text-success me-2"></i>Create New Project</h4>
                </div>
                <div class="card-body p-4">
                    <% if (typeof error !=='undefined' && error) { %>
                        <div class="alert alert-danger">
                            <%= error %>
                        </div>
                        <% } %>

                            <form action="/projects" method="POST">
                                <div class="mb-3">
                                    <label for="name" class="form-label">Project Name <span
                                            class="text-danger">*</span></label>
                                    <input type="text" class="form-control bg-dark text-light border-secondary"
                                        id="name" name="name" required placeholder="My Awesome App">
                                    <div class="form-text text-muted">A descriptive name for your project</div>
                                </div>
                                <div class="mb-3">
                                    <label for="githubUrl" class="form-label">GitHub Repository URL <span
                                            class="text-muted">(optional)</span></label>
                                    <input type="url" class="form-control bg-dark text-light border-secondary"
                                        id="githubUrl" name="githubUrl" placeholder="https://github.com/username/repo">
                                    <div class="form-text text-muted">Link to the source code repository</div>
                                </div>
                                <div class="mb-3">
                                    <label for="domain" class="form-label">Domain <span
                                            class="text-muted">(optional)</span></label>
                                    <input type="text" class="form-control bg-dark text-light border-secondary"
                                        id="domain" name="domain" placeholder="example.com">
                                    <div class="form-text text-muted">Deployment domain or URL</div>
                                </div>
                                <div class="mb-3">
                                    <label for="description" class="form-label">Description <span
                                            class="text-muted">(optional)</span></label>
                                    <textarea class="form-control bg-dark text-light border-secondary" id="description"
                                        name="description" rows="3"
                                        placeholder="A brief description of your project"></textarea>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-check-lg me-1"></i> Create Project
                                    </button>
                                    <a href="/<%= user.username %>" class="btn btn-outline-secondary">Cancel</a>
                                </div>
                            </form>
                </div>
            </div>
        </div>
    </div>
</div>