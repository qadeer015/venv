<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/<%= user.username %>" class="text-success text-decoration-none">
                    <%= owner.username %>
                </a></li>
            <li class="breadcrumb-item"><a href="/<%= owner.username %>/<%= project.slug %>"
                    class="text-success text-decoration-none">
                    <%= project.name %>
                </a></li>
            <li class="breadcrumb-item active" aria-current="page">Settings</li>
        </ol>
    </nav>

    <% if (typeof error !=='undefined' && error) { %>
        <div class="alert alert-danger">
            <%= error %>
        </div>
        <% } %>
            <% if (typeof success !=='undefined' && success) { %>
                <div class="alert alert-success">
                    <%= success %>
                </div>
                <% } %>

                    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
                        <div>
                            <h1 class="fw-bold mb-1"><i class="bi bi-gear-fill me-2"></i>Project Settings</h1>
                            <p class="text-muted mb-0">
                                <i class="bi bi-box me-1"></i>
                                <%= project.name %>
                            </p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Main Settings Content -->
                        <div class="col-lg-8">
                            <!-- Edit Project Form -->
                            <div class="card bg-dark border-secondary mb-4">
                                <div class="card-header bg-dark border-secondary">
                                    <h5 class="mb-0"><i class="bi bi-pencil-fill text-warning me-2"></i>Edit Project
                                    </h5>
                                </div>
                                <div class="card-body p-4">
                                    <form action="/<%= owner.username %>/<%= project.slug %>?_method=PUT" method="POST">
                                        <div class="mb-3">
                                            <label for="name" class="form-label">Project Name <span
                                                    class="text-danger">*</span></label>
                                            <input type="text" class="form-control bg-dark text-light border-secondary"
                                                id="name" name="name" value="<%= project.name %>" required>
                                        </div>
                                        <div class="mb-3">
                                            <label for="githubUrl" class="form-label">GitHub Repository URL <span
                                                    class="text-muted">(optional)</span></label>
                                            <input type="url" class="form-control bg-dark text-light border-secondary"
                                                id="githubUrl" name="githubUrl" value="<%= project.github_url || '' %>"
                                                placeholder="https://github.com/username/repo">
                                        </div>
                                        <div class="mb-3">
                                            <label for="domain" class="form-label">Domain <span
                                                    class="text-muted">(optional)</span></label>
                                            <input type="text" class="form-control bg-dark text-light border-secondary"
                                                id="domain" name="domain" value="<%= project.domain || '' %>"
                                                placeholder="example.com">
                                        </div>
                                        <div class="mb-3">
                                            <label for="description" class="form-label">Description <span
                                                    class="text-muted">(optional)</span></label>
                                            <textarea class="form-control bg-dark text-light border-secondary"
                                                id="description" name="description"
                                                rows="3"><%= project.description || '' %></textarea>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button type="submit" class="btn btn-warning">
                                                <i class="bi bi-check-lg me-1"></i> Update Project
                                            </button>
                                            <a href="/<%= owner.username %>/<%= project.slug %>"
                                                class="btn btn-outline-secondary">Cancel</a>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <!-- Danger Zone - Delete Project -->
                            <div class="card bg-dark border-danger mb-4">
                                <div class="card-header bg-danger bg-opacity-10 border-danger">
                                    <h5 class="mb-0 text-danger"><i
                                            class="bi bi-exclamation-triangle-fill me-2"></i>Danger Zone</h5>
                                </div>
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1">Delete this project</h6>
                                            <p class="text-muted small mb-0">Once you delete a project, there is no
                                                going back. Please be certain.</p>
                                        </div>
                                        <form action="/<%= owner.username %>/<%= project.slug %>?_method=DELETE"
                                            method="POST" class="d-inline"
                                            onsubmit="return confirm('Delete this project and all its environment variables? This action cannot be undone.')">
                                            <button type="submit" class="btn btn-danger">
                                                <i class="bi bi-trash me-1"></i> Delete Project
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sidebar - Access Management -->
                        <div class="col-lg-4">
                            <!-- Project Info -->
                            <div class="card bg-dark border-secondary mb-4">
                                <div class="card-header bg-dark border-secondary">
                                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Project Info</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="mb-0">
                                        <dt class="text-muted small">Created</dt>
                                        <dd>
                                            <%= new Date(project.created_at).toLocaleString() %>
                                        </dd>
                                        <dt class="text-muted small">Updated</dt>
                                        <dd>
                                            <%= new Date(project.updated_at).toLocaleString() %>
                                        </dd>
                                        <dt class="text-muted small">Environment Variables</dt>
                                        <dd>
                                            <%= envVarsCount %>
                                        </dd>
                                    </dl>
                                </div>
                            </div>

                            <!-- Access Management (Owner only) -->
                            <% if (isOwner) { %>
                                <div class="card bg-dark border-secondary mb-4">
                                    <div class="card-header bg-dark border-secondary">
                                        <h5 class="mb-0"><i class="bi bi-people-fill text-info me-2"></i>Access
                                            Management</h5>
                                    </div>
                                    <div class="card-body">
                                        <!-- Invite User Form with Search -->
                                        <form action="/<%= owner.username %>/<%= project.slug %>/access/invite"
                                            method="POST" class="mb-3" id="inviteForm">
                                            <label for="inviteUser" class="form-label small">Invite user by
                                                username or email</label>
                                            <div class="input-group mb-2">
                                                <input type="text"
                                                    class="form-control bg-dark text-light border-secondary"
                                                    id="inviteUser" name="identifier" required
                                                    placeholder="Search username or email..." autocomplete="off">
                                                <button type="submit" class="btn btn-outline-info">
                                                    <i class="bi bi-send"></i> Send Invite
                                                </button>
                                            </div>
                                            <!-- Search Results Dropdown -->
                                            <div id="userSearchResults" class="list-group mb-2" style="display: none;">
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="permission"
                                                    id="permView" value="view" checked>
                                                <label class="form-check-label small" for="permView">View</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="permission"
                                                    id="permEdit" value="edit">
                                                <label class="form-check-label small" for="permEdit">Edit</label>
                                            </div>
                                        </form>

                                        <!-- Access List -->
                                        <% if (accessList.length > 0) { %>
                                            <hr class="border-secondary">
                                            <h6 class="small text-muted mb-2">Users with access</h6>
                                            <div class="list-group list-group-flush">
                                                <% accessList.forEach(function(access) { %>
                                                    <% var isPendingInvite = (access.status === 'invited' || access.status === 'pending'); %>
                                                    <% var statusLabel = access.status === 'approved' ? access.permission : (access.status === 'invited' ? 'Invited' : (access.status === 'pending' ? 'Pending' : access.status)); %>
                                                    <% var badgeClass = access.status === 'approved' ? (access.permission === 'edit' ? 'warning' : 'secondary') : (access.status === 'invited' ? 'info' : (access.status === 'pending' ? 'info' : 'danger')); %>
                                                    <% var revokeConfirm = access.status === 'approved' ? 'Revoke access for this user?' : 'Revoke this invitation?'; %>
                                                    <div class="list-group-item bg-dark text-light border-secondary px-0 d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <small><%= access.user_name || access.email %></small>
                                                            <span class="badge bg-<%= badgeClass %> ms-1"><%= statusLabel %></span>
                                                            <% if (access.expires_at && isPendingInvite) { %>
                                                                <small class="text-muted d-block">Expires <%= new Date(access.expires_at).toLocaleDateString() %></small>
                                                            <% } %>
                                                        </div>
                                                        <div class="d-flex gap-1">
                                                            <% if (isPendingInvite) { %>
                                                                <% if (access.status === 'pending') { %>
                                                                    <form action="/<%= owner.username %>/<%= project.slug %>/access/<%= access.id %>/approve" method="POST" class="d-inline">
                                                                        <button type="submit" class="btn btn-sm btn-outline-success border-0" title="Approve"><i class="bi bi-check-lg"></i></button>
                                                                    </form>
                                                                    <form action="/<%= owner.username %>/<%= project.slug %>/access/<%= access.id %>/reject" method="POST" class="d-inline">
                                                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Reject"><i class="bi bi-x-lg"></i></button>
                                                                    </form>
                                                                <% } else { %>
                                                                    <span class="small text-muted d-inline-block me-1">Pending acceptance</span>
                                                                <% } %>
                                                                <form action="/<%= owner.username %>/<%= project.slug %>/access/<%= access.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('<%= revokeConfirm %>')">
                                                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Revoke"><i class="bi bi-person-x"></i></button>
                                                                </form>
                                                            <% } else if (access.status === 'approved') { %>
                                                                <form action="/<%= owner.username %>/<%= project.slug %>/access/<%= access.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('<%= revokeConfirm %>')">
                                                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Revoke"><i class="bi bi-person-x"></i></button>
                                                                </form>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                <% }); %>
                                            </div>
                                        <% } else { %>
                                            <p class="text-muted small mb-0">No users have been granted access yet</p>
                                        <% } %>
                                    </div>
                                </div>
                                <% } %>
                        </div>
                    </div>
</div>