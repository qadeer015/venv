<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard" class="text-success text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/projects/<%= project.id %>" class="text-success text-decoration-none"><%= project.name %></a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edit</li>
                </ol>
            </nav>

            <div class="card bg-dark border-secondary">
                <div class="card-header bg-dark border-secondary">
                    <h4 class="mb-0"><i class="bi bi-pencil-fill text-warning me-2"></i>Edit Project</h4>
                </div>
                <div class="card-body p-4">
                    <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                    <% } %>

                    <form action="/projects/<%= project.id %>?_method=PUT" method="POST">
                        <div class="mb-3">
                            <label for="name" class="form-label">Project Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control bg-dark text-light border-secondary" id="name" name="name" value="<%= project.name %>" required>
                        </div>
                        <div class="mb-3">
                            <label for="githubUrl" class="form-label">GitHub Repository URL <span class="text-muted">(optional)</span></label>
                            <input type="url" class="form-control bg-dark text-light border-secondary" id="githubUrl" name="githubUrl" value="<%= project.github_url || '' %>" placeholder="https://github.com/username/repo">
                        </div>
                        <div class="mb-3">
                            <label for="domain" class="form-label">Domain <span class="text-muted">(optional)</span></label>
                            <input type="text" class="form-control bg-dark text-light border-secondary" id="domain" name="domain" value="<%= project.domain || '' %>" placeholder="example.com">
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">Description <span class="text-muted">(optional)</span></label>
                            <textarea class="form-control bg-dark text-light border-secondary" id="description" name="description" rows="3"><%= project.description || '' %></textarea>
                        </div>
                        <% if (typeof dbSchema !== 'undefined' && dbSchema) { %>
                        <div class="mb-3">
                            <label for="dbSchema" class="form-label">Database Schema <span class="text-muted">(optional)</span></label>
                            <textarea class="form-control bg-dark text-light border-secondary font-monospace" id="dbSchema" name="dbSchema" rows="6"><%= dbSchema %></textarea>
                            <div class="form-text text-muted">Update your database schema SQL.</div>
                        </div>
                        <% } else { %>
                        <div class="mb-3">
                            <label for="dbSchema" class="form-label">Database Schema <span class="text-muted">(optional)</span></label>
                            <textarea class="form-control bg-dark text-light border-secondary font-monospace" id="dbSchema" name="dbSchema" rows="6" placeholder="CREATE TABLE users (&#10;  id INT PRIMARY KEY,&#10;  name VARCHAR(255)&#10;);"></textarea>
                            <div class="form-text text-muted">Paste your database schema SQL here.</div>
                        </div>
                        <% } %>
                        <div class="mb-3">
                            <label for="envFile" class="form-label">Project .env File <span class="text-muted">(optional)</span></label>
                            <textarea class="form-control bg-dark text-light border-secondary font-monospace" id="envFile" name="envFile" rows="6" placeholder="DATABASE_URL=mysql://user:pass@host/db&#10;API_KEY=your-api-key-here&#10;SECRET_KEY=your-secret-key"><%= typeof envFileContent !== 'undefined' ? envFileContent : '' %></textarea>
                            <div class="form-text text-muted">Paste your .env file content (KEY=VALUE pairs). Existing env vars will be updated/replaced.</div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-lg me-1"></i> Update Project
                            </button>
                            <a href="/projects/<%= project.id %>" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>