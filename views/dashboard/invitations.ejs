<div class="container py-5" style="max-width: 720px;">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <a href="/<%= owner.username %>" class="text-success text-decoration-none">
          <%= owner.username %>
        </a>
      </li>
      <li class="breadcrumb-item">
        <a href="/<%= owner.username %>/<%= project.slug %>" class="text-success text-decoration-none">
          <%= project.name %>
        </a>
      </li>
      <li class="breadcrumb-item active" aria-current="page">Invitation</li>
    </ol>
  </nav>

  <!-- Invitation Card -->
  <div class="card bg-dark border-secondary border-0">
    <div class="card-body p-4 p-md-5 text-center">
      <!-- Inviter Avatar -->
      <div class="d-flex align-items-center justify-content-center mb-4 gap-2">
        <div class="d-flex align-items-center justify-content-center">
          <img src="<%= owner.avatar %>" width="56px" height="56px" class="rounded-circle">
        </div>
        <i class="bi bi-plus fs-4"></i>
        <div class="d-flex align-items-center justify-content-center">
          <img src="<%= user.avatar %>" width="56px" height="56px" class="rounded-circle">
        </div>
      </div>

      <p class="fw-bold mb-1 fs-4">
        <a href="/<%= owner.username %>"><%= owner.username %></a>
        invited you to have
        <span class="badge bg-<%= invitation.permission === 'edit' ? 'warning' : 'secondary' %>">
          <i class="bi bi-<%= invitation.permission === 'edit' ? 'pencil-square' : 'eye' %> me-1"></i>
          <%= invitation.permission %>
        </span> access of
      </p>

      <p class="fw-bold fs-4 mb-4">
        <%= owner.username %>/<%= project.name %>
      </p>

      <!-- Accept / Reject Buttons -->
      <div class="d-grid gap-2 d-md-flex justify-content-center mb-4">
        <form action="/<%= owner.username %>/<%= project.slug %>/invitations/accept" method="POST" class="d-inline">
          <button type="submit" class="btn btn-success btn-lg px-4">
            Accept invitation
          </button>
        </form>
        <form action="/<%= owner.username %>/<%= project.slug %>/invitations/decline" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to decline this invitation?')">
          <button type="submit" class="btn btn-outline-secondary btn-lg px-4">
            Decline invitation
          </button>
        </form>
      </div>

       <!-- Environments Access -->
       <% if (invitation.environments && invitation.environments.length > 0) { %>
       <div class="mb-4">
         <small class="text-muted d-block mb-2">
           <i class="bi bi-layers me-1"></i>Environments you'll have access to:
         </small>
         <div class="d-flex justify-content-center gap-2 flex-wrap">
           <% invitation.environments.forEach(function(env) { %>
           <span class="badge bg-dark border border-secondary text-light px-3 py-2">
             <i class="bi bi-<%= env === 'development' ? 'code-slash' : (env === 'staging' ? 'bezier2' : 'globe') %> me-1"></i>
             <%= env.charAt(0).toUpperCase() + env.slice(1) %>
           </span>
           <% }); %>
         </div>
       </div>
       <% } %>

      <p class="text-muted small mt-4 mb-0">
        <i class="bi bi-shield-check me-1"></i>
        By accepting, you will be granted
        <strong><%= invitation.permission %> access</strong>
        <% if (invitation.environments && invitation.environments.length > 0) { %>
        to these
        <strong><%= invitation.environments.length %></strong>
        environment<%= invitation.environments.length > 1 ? 's' : '' %>
        <% } %>
        on this project.
      </p>

       <!-- Security Note -->
       <p class="text-center text-muted small mt-4">
         <i class="bi bi-info-circle me-1"></i>
         Only project invitations that were sent to your account are visible here.
       </p>
    </div>
  </div>
</div>