<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Venv Manager</title>

    <!-- Bootstrap 5 (dark theme native) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { min-height: 100vh; }
        .sidebar {
            width: 250px;
            min-height: calc(100vh - 56px);
        }
        @media (max-width: 768px) {
            .sidebar { width: 100%; min-height: auto; }
        }
        .env-value {
            font-family: 'Cascadia Code', 'Fira Code', 'Consolas', monospace;
            word-break: break-all;
        }
    </style>
</head>
<body class="bg-dark text-light">

    <% if (typeof header !== 'undefined' && header) { %>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard">
                <i class="bi bi-shield-lock-fill text-success me-2"></i>Venv
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <% if (typeof user !== 'undefined' && user) { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard">
                            <i class="bi bi-grid-fill"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/projects/create">
                            <i class="bi bi-plus-circle-fill"></i> New Project
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span class="ms-1"><%= user.email %></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                            <li><span class="dropdown-item-text text-muted"><%= user.email %></span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form action="/auth/logout" method="POST">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                    <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/auth/login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/auth/register">Register</a>
                    </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>
    <% } %>

    <!-- Main Content -->
    <main class="container-fluid p-0">
        <%- body %>
    </main>

    <% if (typeof footer !== 'undefined' && footer) { %>
    <!-- Footer -->
    <footer class="bg-dark border-top border-secondary py-3 mt-auto">
        <div class="container text-center text-muted small">
            &copy; <%= typeof currentYear !== 'undefined' ? currentYear : '2026' %> Venv Manager &mdash; Secure .env Credentials Management
        </div>
    </footer>
    <% } %>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom Utilities -->
    <script src="/js/utils/toast.js"></script>
</body>
</html>