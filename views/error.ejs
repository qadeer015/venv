<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="col-md-6 text-center">
            <% if (isNotFound) { %>
                <i class="bi bi-emoji-frown text-muted" style="font-size: 5rem;"></i>
                <h1 class="display-4 fw-bold mt-3">404</h1>
                <h4 class="text-muted">
                    <%= title %>
                </h4>
                <p class="text-muted mb-4">
                    <%= message %>
                </p>
                <a href="/<%= user.username %>" class="btn btn-success btn-lg">
                    <i class="bi bi-house-door-fill me-2"></i>Go to Dashboard
                </a>
                <% } else if (isServerError) { %>
                    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 5rem;"></i>
                    <h1 class="display-4 fw-bold mt-3">
                        <%= statusCode %>
                    </h1>
                    <h4 class="text-muted">
                        <%= title %>
                    </h4>
                    <p class="text-muted mb-4">
                        <%= message %>
                    </p>
                    <a href="/<%= user.username %>" class="btn btn-success btn-lg">
                        <i class="bi bi-arrow-left me-2"></i>Go Back
                    </a>
                    <% } else { %>
                        <i class="bi bi-shield-exclamation-fill text-warning" style="font-size: 5rem;"></i>
                        <h1 class="display-4 fw-bold mt-3">
                            <%= statusCode %>
                        </h1>
                        <h4 class="text-muted">
                            <%= title %>
                        </h4>
                        <p class="text-muted mb-4">
                            <%= message %>
                        </p>
                        <a href="<%= typeof redirect_url !== 'undefined' ? redirect_url : '/' %>"
                            class="btn btn-success btn-lg">
                            <i class="bi bi-arrow-left me-2"></i>Go Back
                        </a>
                        <% } %>

                            <% if (typeof error !=='undefined' && error) { %>
                                <hr class="border-secondary my-4">
                                <div class="text-start">
                                    <pre class="text-danger small"><%= error %></pre>
                                </div>
                                <% } %>
        </div>
    </div>
</div>