<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="col-md-5 col-lg-4">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock-fill text-success" style="font-size: 3rem;"></i>
                <h2 class="fw-bold mt-2">Reset Password</h2>
                <p class="text-muted">Enter your new password</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle-fill me-2"></i><%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <div class="text-center mt-3">
                <a href="/auth/login" class="btn btn-outline-success px-4">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Go to Login
                </a>
            </div>
            <% } %>

            <% if (typeof token !== 'undefined' && token) { %>
            <div class="card bg-dark border-secondary">
                <div class="card-body p-4">
                    <form action="/auth/reset-password" method="POST" id="resetPasswordForm">
                        <input type="hidden" name="token" value="<%= token %>">

                        <div class="mb-3">
                            <label for="password" class="form-label">New Password</label>
                            <input type="password" 
                                   class="form-control bg-dark text-light border-secondary" 
                                   id="password" 
                                   name="password" 
                                   required 
                                   minlength="8"
                                   autofocus
                                   placeholder="At least 8 characters">
                            <div class="form-text text-muted">
                                <i class="bi bi-info-circle me-1"></i>Must be at least 8 characters
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Confirm New Password</label>
                            <input type="password" 
                                   class="form-control bg-dark text-light border-secondary" 
                                   id="confirmPassword" 
                                   name="confirmPassword" 
                                   required 
                                   minlength="8"
                                   placeholder="Repeat your new password">
                            <div class="form-text text-muted" id="passwordMatchMsg"></div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold" id="resetBtn">
                            <i class="bi bi-key me-2"></i>Reset Password
                        </button>
                    </form>
                </div>
            </div>

            <p class="text-center mt-3 text-muted">
                <a href="/auth/login" class="text-secondary text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Back to Login
                </a>
            </p>
            <% } %>
        </div>
    </div>
</div>

<script>
(function() {
    const form = document.getElementById('resetPasswordForm');
    const password = document.getElementById('password');
    const confirmPassword = document.getElementById('confirmPassword');
    const resetBtn = document.getElementById('resetBtn');
    const matchMsg = document.getElementById('passwordMatchMsg');

    if (!form) return;

    // Real-time password match validation
    function checkPasswordMatch() {
        if (confirmPassword.value.length === 0) {
            matchMsg.textContent = '';
            return;
        }
        if (password.value === confirmPassword.value) {
            matchMsg.innerHTML = '<i class="bi bi-check-circle text-success me-1"></i>Passwords match';
            matchMsg.className = 'form-text text-success';
        } else {
            matchMsg.innerHTML = '<i class="bi bi-exclamation-circle text-danger me-1"></i>Passwords do not match';
            matchMsg.className = 'form-text text-danger';
        }
    }

    password.addEventListener('input', checkPasswordMatch);
    confirmPassword.addEventListener('input', checkPasswordMatch);

    // Form validation on submit
    form.addEventListener('submit', function(e) {
        if (password.value.length < 8) {
            e.preventDefault();
            return;
        }
        if (password.value !== confirmPassword.value) {
            e.preventDefault();
            matchMsg.innerHTML = '<i class="bi bi-exclamation-circle text-danger me-1"></i>Passwords do not match';
            matchMsg.className = 'form-text text-danger';
            return;
        }
        resetBtn.disabled = true;
        resetBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Resetting...';
    });
})();
</script>