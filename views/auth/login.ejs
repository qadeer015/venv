<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="col-md-5 col-lg-4">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock-fill text-success" style="font-size: 3rem;"></i>
                <h2 class="fw-bold mt-2">Venv Manager</h2>
                <p class="text-muted">Sign in to manage your .env credentials</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

            <div class="card bg-dark border-secondary">
                <div class="card-body p-4">
                    <form action="/auth/login" method="POST">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email address</label>
                            <input type="email" class="form-control bg-dark text-light border-secondary" id="email" name="email" required autofocus placeholder="you@example.com">
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" class="form-control bg-dark text-light border-secondary" id="password" name="password" required placeholder="••••••••">
                        </div>
                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </button>
                    </form>
                </div>
            </div>

            <p class="text-center mt-3 text-muted">
                Don't have an account?
                <a href="/auth/register" class="text-success text-decoration-none fw-semibold">Create one</a>
            </p>
        </div>
    </div>
</div>